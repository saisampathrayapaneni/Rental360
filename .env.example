# Rental360 — environment template.
# Copy to .env and fill in values. Never commit a real .env with secrets.
# No secrets are required to run the app: the assistant works without an LLM
# key (deterministic intent parser). A key only enables the optional LLM seam.

# Port the API listens on (default 8000)
PORT=8000

# Path to the SQLite warehouse (relative to repo root, or absolute)
RENTAL360_DB=data/warehouse/rental360.db

# Optional LLM provider for app/llm_client.py (leave blank to stay deterministic)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# LLM_MODEL=gpt-4o-mini
